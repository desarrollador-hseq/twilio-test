# SQLite local. La ruta es relativa a la carpeta prisma/ (donde está schema.prisma).
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
AUTH_SECRET="genera-un-secreto-largo-y-aleatorio"
# AUTH_URL="http://localhost:9000"

# URL pública de la app (Twilio webhooks). En local: npm run tunnel
NEXT_PUBLIC_APP_URL="http://localhost:9000"

# ngrok — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=""

# Credenciales Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Remitente WhatsApp — DEBE ser el número de Twilio, NO tu celular personal.
# Sandbox (pruebas): whatsapp:+14155238886  (ver en Twilio Console → Messaging → Try WhatsApp)
# Producción: el número Business aprobado en Twilio → Messaging → Senders
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Alternativa: Messaging Service SID (si usas un Messaging Service con canal WhatsApp)
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Webhooks Twilio (requieren URL pública; en local: npm run tunnel)
# Estado de entrega:  {NEXT_PUBLIC_APP_URL}/api/webhooks/twilio/status
# Mensajes entrantes: {NEXT_PUBLIC_APP_URL}/api/webhooks/twilio/inbound
# Configura "When a message comes in" en Twilio Console → Messaging → Senders (WhatsApp)
